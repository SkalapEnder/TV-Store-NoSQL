<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../templates/head', { title: 'Edit profile' }); %>
</head>
<body>
<%- include('../templates/navbar'); %>
<% const p = user.profile || {}; %>

<main class="container page">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/auth/profile">My profile</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>

    <div class="mx-auto fade-in" style="max-width: 760px">
        <div class="page-header">
            <div>
                <h1 class="serif">Edit profile</h1>
                <p class="lead-text">Keep your contact details up to date</p>
            </div>
        </div>

        <form action="/auth/update" method="POST" class="surface surface-pad">
            <div class="small-caps mb-3">Account</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="username" class="form-label">Name *</label>
                    <input type="text" id="username" class="form-control" name="username" value="<%= user.username %>" required maxlength="50">
                </div>
                <div class="col-md-6">
                    <label for="email" class="form-label">Email *</label>
                    <input type="email" id="email" class="form-control" name="email" value="<%= user.email %>" required>
                </div>
                <div class="col-md-6">
                    <label for="role" class="form-label">Account type</label>
                    <select id="role" name="role" class="form-select" onchange="toggleSecretCode()" required>
                        <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>Customer</option>
                        <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Administrator</option>
                    </select>
                </div>
                <div id="secretCodeDiv" class="col-md-6 d-none">
                    <label for="secret-code" class="form-label">Administrator code</label>
                    <input type="password" id="secret-code" class="form-control" name="secret_code" placeholder="Required to become an administrator">
                </div>
            </div>

            <div class="divider-text">Personal information</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="full_name" class="form-label">Full name</label>
                    <input type="text" id="full_name" class="form-control" name="full_name" maxlength="100" value="<%= p.full_name || '' %>" autocomplete="name">
                </div>
                <div class="col-md-6">
                    <label for="phone" class="form-label">Phone</label>
                    <input type="tel" id="phone" class="form-control" name="phone" maxlength="20" value="<%= p.phone || '' %>" autocomplete="tel">
                </div>
                <div class="col-md-6">
                    <label for="city" class="form-label">City</label>
                    <input type="text" id="city" class="form-control" name="city" maxlength="60" value="<%= p.city || '' %>">
                </div>
                <div class="col-md-6">
                    <label for="birth_date" class="form-label">Birth date</label>
                    <input type="date" id="birth_date" class="form-control" name="birth_date"
                           value="<%= p.birth_date ? new Date(p.birth_date).toISOString().slice(0, 10) : '' %>">
                </div>
                <div class="col-12">
                    <label for="about" class="form-label">About me</label>
                    <textarea id="about" class="form-control" name="about" maxlength="500" rows="3"><%= p.about || '' %></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/auth/profile" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-brand" data-loading-text="Saving…">Save changes</button>
            </div>
        </form>
    </div>
</main>

<%- include('../templates/footer'); %>
<script>
    const currentRole = "<%= user.role %>";
    function toggleSecretCode() {
        const role = document.getElementById('role').value;
        document.getElementById('secretCodeDiv').classList.toggle('d-none', !(role === 'admin' && currentRole !== 'admin'));
    }
    toggleSecretCode();
</script>
</body>
</html>
