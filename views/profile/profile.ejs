<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body{
            background-color: #dbdbdb;
        }
    </style>
</head>
<body>
<%- include('../templates/navbar'); %>

<div class="container bg-white shadow rounded w-50 my-4 text-center p-5 pb-4">
    <h1>Profile Page</h1>
    <div class="profile-image">
        <img src="https://eu.ui-avatars.com/api/?name=<%= user.username %>&size=150" class="rounded-circle" alt="Profile Picture" />
    </div>

    <div class="justify-content-center mt-4">
        <div>
            <h3>User ID: <%= user._id %></h3>
            <h3>Name: <%= user.username %></h3>
            <h3>Email: <%= user.email %></h3>
            <h3>Role: <%= capitalizeFirstLetter(user.role) %></h3>
        </div>
        <br>
        <div>
            <h3>Profile data info</h3>
            <h4>Created: <%= convertData(user.createdAt) %></h4>
            <h4>Updated: <%= convertData(user.updatedAt) %></h4>
        </div>
    </div>

    <div class="mt-4 mx-auto">
        <% if (user.role === 'admin') {%>
            <div class="mt-4 mx-auto">
                <form action="/products/admin" method="GET" style="display: inline;">
                    <button type="submit" class="btn btn-outline-primary fs-5">Product Management</button>
                </form>
                <form action="/brands/admin" method="GET" style="display: inline;">
                    <button type="submit" class="btn btn-outline-primary fs-5">Brand Management</button>
                </form>
                <form action="/categories/admin" method="GET" style="display: inline;">
                    <button type="submit" class="btn btn-outline-primary fs-5">Category Management</button>
                </form>
            </div>

            <div class="mt-4 mx-auto">
                <form action="/users/admin" method="GET" style="display: inline;">
                    <button type="submit" class="btn btn-outline-primary fs-5">User Management</button>
                </form>
<!--                <form action="/mongo" method="GET" style="display: inline;">-->
<!--                    <button type="submit" class="btn btn-outline-primary fs-5">Console</button>-->
<!--                </form>-->
                <form action="/products/admin/scrape" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-outline-primary fs-5">Scrap Data</button>
                </form>
            </div>
        <% } %>

        <div class="mt-4 mx-auto">
            <form action="/auth/update" method="GET" style="display: inline;">
                <button type="submit" class="btn btn-success fs-5">Update User</button>
            </form>
            <form action="/auth/logout" method="GET" style="display: inline;">
                <button type="submit" class="btn btn-secondary fs-5">Log Out</button>
            </form>
            <form action="/auth/delete-account" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-outline-danger fs-5">Delete Account</button>
            </form>
        </div>
    </div>
</div>

<div class="container bg-white shadow rounded w-75 my-4 p-4">
    <section class="text-start">
        <h2 class="text-center">Recently Viewed Products</h2>
        <% if (user.view_history && user.view_history.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Product</th>
                            <th scope="col">Price (KZT)</th>
                            <th scope="col">Views</th>
                            <th scope="col">Last Viewed</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% user.view_history.forEach((item) => { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <% if (item.pictures && item.pictures.length > 0) { %>
                                            <img src="<%= item.pictures[0] %>" alt="" loading="lazy" style="width: 64px; height: 48px; object-fit: contain;">
                                        <% } %>
                                        <div>
                                            <div><%= item.name || 'Product' %></div>
                                            <small class="text-muted">ID: <%= item.product_id %></small>
                                        </div>
                                    </div>
                                </td>
                                <td><%= typeof item.price === 'number' ? item.price.toFixed(2) : 'N/A' %></td>
                                <td><%= item.views || 0 %></td>
                                <td><%= item.lastViewed ? convertData(item.lastViewed) : 'N/A' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-center text-muted">You have not viewed any products yet.</p>
        <% } %>
    </section>
</div>

<div class="container bg-white shadow rounded w-75 my-4 p-4">
    <section class="text-start">
        <h2 class="text-center">Purchase History</h2>
        <% if (user.purchase_history && user.purchase_history.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Product</th>
                            <th scope="col">Order ID</th>
                            <th scope="col">Unit Price (KZT)</th>
                            <th scope="col">Quantity</th>
                            <th scope="col">Total (KZT)</th>
                            <th scope="col">Purchased</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% user.purchase_history.slice().reverse().forEach((item) => { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <% if (item.picture) { %>
                                            <img src="<%= item.picture %>" alt="" loading="lazy" style="width: 64px; height: 48px; object-fit: contain;">
                                        <% } %>
                                        <div>
                                            <div><%= item.name || 'Product' %></div>
                                            <small class="text-muted">ID: <%= item.product_id %></small>
                                        </div>
                                    </div>
                                </td>
                                <td><small><%= item.order_id %></small></td>
                                <td><%= typeof item.price === 'number' ? item.price.toFixed(2) : 'N/A' %></td>
                                <td><%= item.quantity %></td>
                                <td><%= typeof item.price === 'number' ? (item.price * item.quantity).toFixed(2) : 'N/A' %></td>
                                <td><%= item.purchasedAt ? convertData(item.purchasedAt) : 'N/A' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-center text-muted">You have not purchased any products yet.</p>
        <% } %>
    </section>
</div>

<%- include('../templates/footer'); %>
</body>
</html>
