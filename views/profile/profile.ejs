<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../templates/head', { title: 'My profile' }); %>
</head>
<body>
<%- include('../templates/navbar'); %>
<%
  const p = user.profile || {};
  const fmt = n => Number(n || 0).toLocaleString('ru-RU');
  const fmtDate = d => d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
  const fmtDateTime = d => d ? new Date(d).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
%>

<main class="container page">
    <div class="row g-4">
        <!-- Sidebar -->
        <aside class="col-lg-3">
            <div class="surface surface-pad profile-aside buy-box">
                <div class="text-center mb-3">
                    <span class="avatar avatar-lg mb-3"><%= (user.username || '?').trim().charAt(0) %></span>
                    <h1 class="h5 mb-0"><%= p.full_name || user.username %></h1>
                    <div class="text-muted small text-truncate"><%= user.email %></div>
                    <div class="mt-2">
                        <span class="badge-soft <%= user.role === 'admin' ? 'badge-brand' : 'badge-neutral' %>"><%= user.role === 'admin' ? 'Administrator' : 'Customer' %></span>
                    </div>
                </div>
                <nav class="nav flex-column gap-1">
                    <a class="nav-link active" href="#overview"><i class="bi bi-grid"></i> Overview</a>
                    <a class="nav-link" href="#orders"><i class="bi bi-receipt"></i> Orders <span class="ms-auto small text-muted"><%= stats.orders %></span></a>
                    <a class="nav-link" href="#viewed"><i class="bi bi-clock-history"></i> Viewed <span class="ms-auto small text-muted"><%= stats.viewed %></span></a>
                    <a class="nav-link" href="/recommendations"><i class="bi bi-stars"></i> For you</a>
                    <a class="nav-link" href="/auth/update"><i class="bi bi-pencil-square"></i> Edit profile</a>
                    <a class="nav-link" href="/cart"><i class="bi bi-bag"></i> Cart</a>
                    <hr class="my-2">
                    <a class="nav-link" href="/auth/logout"><i class="bi bi-box-arrow-right"></i> Log out</a>
                </nav>
            </div>
        </aside>

        <!-- Content -->
        <div class="col-lg-9">
            <!-- Overview -->
            <section id="overview" class="mb-5">
                <div class="page-header mb-3">
                    <div>
                        <h2 class="serif mb-0">Hello, <%= user.username %></h2>
                        <p class="lead-text">Member since <%= fmtDate(user.createdAt) %></p>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-label"><i class="bi bi-receipt"></i>Orders</div><div class="stat-value"><%= stats.orders %></div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-label"><i class="bi bi-box-seam"></i>Items bought</div><div class="stat-value"><%= stats.items %></div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-label"><i class="bi bi-wallet2"></i>Total spent</div><div class="stat-value"><%= fmt(stats.spent) %> <small class="fs-6 text-muted">₸</small></div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-tile"><div class="stat-label"><i class="bi bi-star"></i>Ratings given</div><div class="stat-value"><%= stats.rated %></div></div></div>
                </div>

                <div class="surface surface-pad">
                    <div class="section-title">
                        <h3 class="h5">Personal information</h3>
                        <a href="/auth/update" class="btn btn-outline-brand btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
                    </div>
                    <dl class="info-list">
                        <div><dt>Name</dt><dd><%= user.username %></dd></div>
                        <div><dt>Full name</dt><dd><%= p.full_name || '—' %></dd></div>
                        <div><dt>Email</dt><dd><%= user.email %></dd></div>
                        <div><dt>Phone</dt><dd><%= p.phone || '—' %></dd></div>
                        <div><dt>City</dt><dd><%= p.city || '—' %></dd></div>
                        <div><dt>Birth date</dt><dd><%= p.birth_date ? fmtDate(p.birth_date) : '—' %></dd></div>
                    </dl>
                    <% if (p.about) { %>
                        <hr class="my-3">
                        <dl class="mb-0"><dt class="small text-muted fw-medium mb-1">About me</dt><dd class="mb-0" style="white-space: pre-line"><%= p.about %></dd></dl>
                    <% } %>
                    <% if (!p.full_name && !p.phone && !p.city) { %>
                        <div class="alert alert-light border mt-3 mb-0 small"><i class="bi bi-info-circle me-1"></i>Complete your profile to get faster checkout and better recommendations.</div>
                    <% } %>
                </div>

                <% if (user.role === 'admin') { %>
                    <div class="surface surface-pad mt-3">
                        <h3 class="h5 mb-3">Store management</h3>
                        <div class="row g-2">
                            <div class="col-6 col-md-3"><a class="category-chip" href="/products/admin"><span class="chip-icon"><i class="bi bi-box-seam"></i></span><span class="chip-name">Products</span></a></div>
                            <div class="col-6 col-md-3"><a class="category-chip" href="/users/admin"><span class="chip-icon"><i class="bi bi-people"></i></span><span class="chip-name">Users</span></a></div>
                        </div>
                    </div>
                <% } %>
            </section>

            <!-- Orders -->
            <section id="orders" class="mb-5">
                <div class="section-title">
                    <h2 class="h4">Order history</h2>
                    <% if (orders.length) { %><span class="text-muted small"><%= orders.length %> <%= orders.length === 1 ? 'order' : 'orders' %></span><% } %>
                </div>
                <% if (orders.length === 0) { %>
                    <div class="surface empty-state">
                        <i class="bi bi-receipt empty-icon"></i>
                        <p class="mb-3">You have not placed any orders yet.</p>
                        <a href="/products" class="btn btn-brand">Start shopping</a>
                    </div>
                <% } else { %>
                    <% orders.forEach(order => { %>
                        <article class="order-card">
                            <div class="order-head">
                                <div><span class="label">Order placed</span><span class="value"><%= fmtDateTime(order.purchasedAt) %></span></div>
                                <div><span class="label">Items</span><span class="value"><%= order.count %></span></div>
                                <div><span class="label">Total</span><span class="value"><%= fmt(order.total) %> ₸</span></div>
                                <div class="ms-md-auto text-md-end"><span class="label">Order №</span><span class="value font-monospace small"><%= String(order.order_id).slice(-8).toUpperCase() %></span></div>
                                <span class="badge-soft badge-stock"><i class="bi bi-check2 me-1"></i>Paid</span>
                            </div>
                            <% order.items.forEach(item => { %>
                                <div class="order-line">
                                    <% if (item.picture) { %><img class="thumb" src="<%= item.picture %>" alt="" loading="lazy"><% } %>
                                    <div class="ol-name">
                                        <a href="/products/<%= item.product_id %>" class="d-block text-truncate"><%= item.name || 'Product' %></a>
                                        <span class="small text-muted"><%= item.quantity %> × <%= fmt(item.price) %> ₸</span>
                                    </div>
                                    <div class="price text-end"><%= fmt(item.price * item.quantity) %><small>₸</small></div>
                                </div>
                            <% }) %>
                        </article>
                    <% }) %>
                <% } %>
            </section>

            <!-- Viewed -->
            <section id="viewed" class="mb-5">
                <div class="section-title">
                    <h2 class="h4">Recently viewed</h2>
                    <% if (user.view_history.length) { %><span class="text-muted small"><%= user.view_history.length %> <%= user.view_history.length === 1 ? 'product' : 'products' %></span><% } %>
                </div>
                <% if (user.view_history.length === 0) { %>
                    <div class="surface empty-state">
                        <i class="bi bi-clock-history empty-icon"></i>
                        <p class="mb-3">You have not viewed any products yet.</p>
                        <a href="/products" class="btn btn-outline-brand">Browse catalog</a>
                    </div>
                <% } else { %>
                    <div class="row g-3">
                        <% user.view_history.forEach((item, i) => { %>
                            <div class="col-md-6 col-xl-4 <%= i >= 9 ? 'd-none extra-viewed' : '' %>">
                                <a class="history-card" href="/products/<%= item.product_id %>">
                                    <% if (item.pictures && item.pictures.length) { %><img class="thumb" src="<%= item.pictures[0] %>" alt="" loading="lazy"><% } %>
                                    <div class="min-w-0 flex-grow-1">
                                        <div class="hc-name"><%= item.name || 'Product' %></div>
                                        <div class="price my-1"><%= typeof item.price === 'number' ? fmt(item.price) : '—' %><small>₸</small></div>
                                        <div class="hc-meta d-flex flex-wrap gap-2 align-items-center">
                                            <% if (item.rating) { %>
                                                <span class="stars"><% for (let s = 1; s <= 5; s++) { %><i class="bi <%= s <= item.rating ? 'bi-star-fill' : 'bi-star off' %>"></i><% } %></span>
                                            <% } %>
                                            <span><i class="bi bi-eye me-1"></i><%= item.views || 0 %></span>
                                            <span><%= fmtDate(item.lastViewed) %></span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }) %>
                    </div>
                    <% if (user.view_history.length > 9) { %>
                        <div class="text-center mt-3">
                            <button type="button" class="btn btn-outline-brand" onclick="document.querySelectorAll('.extra-viewed').forEach(e => e.classList.remove('d-none')); this.remove();">
                                Show all <%= user.view_history.length %>
                            </button>
                        </div>
                    <% } %>
                <% } %>
            </section>

            <!-- Danger zone -->
            <section class="surface surface-pad d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h3 class="h6 mb-1">Delete account</h3>
                    <p class="text-muted small mb-0">Your profile, history and cart will be removed permanently.</p>
                </div>
                <form action="/auth/delete-account" method="POST"
                      data-confirm="Your account, order history and cart will be deleted. This cannot be undone."
                      data-confirm-title="Delete your account?" data-confirm-button="Delete account">
                    <button type="submit" class="btn btn-soft-danger">Delete account</button>
                </form>
            </section>
        </div>
    </div>
</main>

<%- include('../templates/footer'); %>
<script>
    // Highlight the sidebar link of the section in view
    const links = document.querySelectorAll('.profile-aside a[href^="#"]');
    const observer = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (!e.isIntersecting) return;
            links.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + e.target.id));
        });
    }, { rootMargin: '-40% 0px -55% 0px' });
    ['overview', 'orders', 'viewed'].forEach(id => { const el = document.getElementById(id); if (el) observer.observe(el); });
</script>
</body>
</html>
