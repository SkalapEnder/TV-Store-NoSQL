<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../templates/head', { title: 'User management' }); %>
</head>
<body>
<%- include('../templates/navbar'); %>
<% const admins = users.filter(u => u.role === 'admin').length; %>

<main class="container-xxl page">
    <%- include('../templates/admin_header', { section: 'users', heading: 'Users', subtitle: users.length + ' accounts · ' + admins + ' administrators' }); %>

    <details class="surface surface-pad collapse-card mb-4">
        <summary>
            <span class="d-flex align-items-center gap-2"><i class="bi bi-person-plus"></i><span class="fw-semibold">Create a user</span></span>
            <i class="bi bi-chevron-down chev"></i>
        </summary>
        <form action="/users/admin" method="POST">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="username" class="form-label">Name *</label>
                    <input type="text" class="form-control" id="username" name="username" required>
                </div>
                <div class="col-md-3">
                    <label for="email" class="form-label">Email *</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                </div>
                <div class="col-md-3">
                    <label for="password" class="form-label">Password *</label>
                    <input type="password" class="form-control" id="password" name="password" required autocomplete="new-password">
                </div>
                <div class="col-md-3">
                    <label for="role" class="form-label">Role</label>
                    <select id="role" name="role" class="form-select" required>
                        <option value="user">Customer</option>
                        <option value="admin">Administrator</option>
                    </select>
                </div>
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-brand"><i class="bi bi-plus-lg me-1"></i>Create user</button>
                </div>
            </div>
        </form>
    </details>

    <div class="table-tools">
        <div class="search">
            <i class="bi bi-search"></i>
            <input type="search" class="form-control" placeholder="Search by name or email…" data-table-search="usersTable">
        </div>
        <span class="text-muted small"><i class="bi bi-key me-1"></i>Granting the administrator role requires the secret code</span>
    </div>

    <div class="table-wrap">
        <table class="table table-hover admin-table" id="usersTable" data-table data-page-size="20">
            <thead>
            <tr>
                <th style="min-width: 220px">User</th>
                <th style="min-width: 220px">Email</th>
                <th style="min-width: 150px">Role</th>
                <th style="min-width: 150px">Admin code</th>
                <th>Orders</th>
                <th>Registered</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            <% users.forEach(user => {
                const orders = new Set((user.purchase_history || []).map(p => p.order_id)).size; %>
                <tr data-user-id="<%= user._id %>">
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="avatar"><%= String(user.username || '?').charAt(0) %></span>
                            <div class="min-w-0 flex-grow-1">
                                <input type="text" class="form-control username fw-medium" value="<%= user.username %>">
                                <div class="col-id ps-2 text-truncate" style="max-width: 200px"><%= user._id %></div>
                            </div>
                        </div>
                    </td>
                    <td><input type="email" class="form-control email" value="<%= user.email %>"></td>
                    <td>
                        <select class="form-select role">
                            <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>Customer</option>
                            <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Administrator</option>
                        </select>
                    </td>
                    <td><input type="password" class="form-control secret-code" placeholder="Only for admin" autocomplete="off"></td>
                    <td class="small"><%= orders %></td>
                    <td class="small text-muted text-nowrap"><%= new Date(user.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                    <td class="actions">
                        <button class="btn btn-brand btn-icon btn-sm" title="Save changes" onclick="updateUser('<%= user._id %>', this)"><i class="bi bi-check-lg"></i></button>
                        <% if (String(user._id) !== String(userId)) { %>
                            <button class="btn btn-soft-danger btn-icon btn-sm" title="Delete" onclick="deleteUser('<%= user._id %>')"><i class="bi bi-trash3"></i></button>
                        <% } else { %>
                            <span class="badge-soft badge-neutral ms-1">You</span>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
            </tbody>
        </table>
    </div>
    <div class="pager" data-table-pager="usersTable"></div>
</main>

<%- include('../templates/footer'); %>
<script>
    async function updateUser(userId, btn) {
        const row = document.querySelector(`tr[data-user-id="${userId}"]`);
        const get = sel => row.querySelector(sel).value;
        btn.disabled = true;
        try {
            const response = await fetch(`/users/admin/${userId}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ username: get(".username"), email: get(".email"), role: get(".role"), secretCode: get(".secret-code") })
            });
            const data = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(data.errorMessage || response.statusText);
            row.classList.remove("dirty");
            row.querySelector(".secret-code").value = "";
            TVStore.notify("User saved");
        } catch (error) {
            TVStore.notify("Could not save the user: " + error.message, "error");
        } finally {
            btn.disabled = false;
        }
    }

    async function deleteUser(userId) {
        const row = document.querySelector(`tr[data-user-id="${userId}"]`);
        const ok = await TVStore.confirmDialog({
            title: `Delete ${row.querySelector(".username").value}?`,
            message: "The account, its history and cart will be deleted. This cannot be undone.",
            confirmText: "Delete user"
        });
        if (!ok) return;
        try {
            const response = await fetch(`/users/admin/${userId}`, { method: "DELETE" });
            if (!response.ok) throw new Error();
            TVStore.notifyAfterReload("User deleted");
            location.reload();
        } catch (error) {
            TVStore.notify("Could not delete the user", "error");
        }
    }
</script>
</body>
</html>
