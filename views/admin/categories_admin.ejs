<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../templates/head', { title: 'Category management' }); %>
</head>
<body>
<%- include('../templates/navbar'); %>

<main class="container-xxl page">
    <%- include('../templates/admin_header', { section: 'categories', heading: 'Categories', subtitle: categories.length + ' display types' }); %>

    <div class="row g-4">
        <div class="col-lg-4">
            <form action="/categories/admin" method="POST" class="surface surface-pad buy-box">
                <h2 class="h5 mb-3"><i class="bi bi-plus-circle me-2"></i>New category</h2>
                <div class="mb-3">
                    <label for="category_id" class="form-label">Category ID *</label>
                    <input type="number" class="form-control" id="category_id" name="category_id" min="1" required
                           value="<%= categories.reduce((m, c) => Math.max(m, c.category_id || 0), 0) + 1 %>">
                </div>
                <div class="mb-3">
                    <label for="category_name" class="form-label">Name *</label>
                    <input type="text" class="form-control" id="category_name" name="category_name" placeholder="e.g. Mini LED" required>
                </div>
                <div class="mb-3">
                    <label for="category_description" class="form-label">Description</label>
                    <textarea class="form-control" id="category_description" name="category_description" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-brand w-100">Create category</button>
            </form>
        </div>

        <div class="col-lg-8">
            <div class="table-tools">
                <div class="search">
                    <i class="bi bi-search"></i>
                    <input type="search" class="form-control" placeholder="Search categories…" data-table-search="categoriesTable">
                </div>
                <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Deleting a category also deletes its products</span>
            </div>
            <div class="table-wrap">
                <table class="table table-hover admin-table" id="categoriesTable" data-table data-page-size="20">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th style="min-width: 160px">Name</th>
                        <th style="min-width: 240px">Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% categories.forEach(category => { %>
                        <tr data-category-id="<%= category.category_id %>">
                            <td class="col-id"><%= category.category_id %></td>
                            <td><input type="text" class="form-control category-name fw-medium" value="<%= category.category_name %>"></td>
                            <td><textarea class="form-control category-desc" rows="1"><%= category.category_description %></textarea></td>
                            <td class="actions">
                                <button class="btn btn-brand btn-icon btn-sm" title="Save changes" onclick="updateCategory('<%= category.category_id %>', this)"><i class="bi bi-check-lg"></i></button>
                                <button class="btn btn-soft-danger btn-icon btn-sm" title="Delete" onclick="deleteCategory('<%= category.category_id %>')"><i class="bi bi-trash3"></i></button>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="pager" data-table-pager="categoriesTable"></div>
        </div>
    </div>
</main>

<%- include('../templates/footer'); %>
<script>
    async function updateCategory(categoryId, btn) {
        const row = document.querySelector(`tr[data-category-id='${categoryId}']`);
        btn.disabled = true;
        try {
            const response = await fetch(`/categories/admin/${categoryId}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: row.querySelector(".category-name").value, description: row.querySelector(".category-desc").value })
            });
            if (!response.ok) throw new Error();
            row.classList.remove("dirty");
            TVStore.notify("Category saved");
        } catch (error) {
            TVStore.notify("Could not save the category", "error");
        } finally {
            btn.disabled = false;
        }
    }

    async function deleteCategory(categoryId) {
        const row = document.querySelector(`tr[data-category-id='${categoryId}']`);
        const ok = await TVStore.confirmDialog({
            title: `Delete ${row.querySelector(".category-name").value}?`,
            message: "All products of this category will be deleted too. This cannot be undone.",
            confirmText: "Delete category"
        });
        if (!ok) return;
        try {
            const response = await fetch(`/categories/admin/${categoryId}`, { method: "DELETE" });
            if (!response.ok) throw new Error();
            TVStore.notifyAfterReload("Category and its products deleted");
            location.reload();
        } catch (error) {
            TVStore.notify("Could not delete the category", "error");
        }
    }
</script>
</body>
</html>
