<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../templates/head', { title: 'Brand management' }); %>
</head>
<body>
<%- include('../templates/navbar'); %>

<main class="container-xxl page">
    <%- include('../templates/admin_header', { section: 'brands', heading: 'Brands', subtitle: brands.length + ' brands' }); %>

    <details class="surface surface-pad collapse-card mb-4">
        <summary>
            <span class="d-flex align-items-center gap-2"><i class="bi bi-plus-circle"></i><span class="fw-semibold">Add a brand</span></span>
            <i class="bi bi-chevron-down chev"></i>
        </summary>
        <form action="/brands/admin" method="POST">
            <div class="row g-3">
                <div class="col-md-2">
                    <label for="brand_id" class="form-label">Brand ID *</label>
                    <input type="number" id="brand_id" name="brand_id" class="form-control" min="1" required
                           value="<%= brands.reduce((m, b) => Math.max(m, b.brand_id || 0), 0) + 1 %>">
                </div>
                <div class="col-md-4">
                    <label for="brand_name" class="form-label">Name *</label>
                    <input type="text" id="brand_name" name="name" class="form-control" required>
                </div>
                <div class="col-md-3">
                    <label for="headquarters" class="form-label">Headquarters</label>
                    <input type="text" id="headquarters" name="headquarters" class="form-control" placeholder="City, country">
                </div>
                <div class="col-md-3">
                    <label for="founded_year" class="form-label">Founded</label>
                    <input type="number" id="founded_year" name="founded_year" class="form-control" min="1800" max="<%= new Date().getFullYear() %>">
                </div>
                <div class="col-md-8">
                    <label for="brand_description" class="form-label">Description</label>
                    <textarea id="brand_description" name="description" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-4">
                    <label for="website" class="form-label">Website</label>
                    <input type="url" id="website" name="website" class="form-control" placeholder="https://">
                </div>
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-brand"><i class="bi bi-plus-lg me-1"></i>Create brand</button>
                </div>
            </div>
        </form>
    </details>

    <div class="table-tools">
        <div class="search">
            <i class="bi bi-search"></i>
            <input type="search" class="form-control" placeholder="Search brands…" data-table-search="brandsTable">
        </div>
        <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Deleting a brand also deletes its products</span>
    </div>

    <div class="table-wrap">
        <table class="table table-hover admin-table" id="brandsTable" data-table data-page-size="20">
            <thead>
            <tr>
                <th>ID</th>
                <th style="min-width: 160px">Name</th>
                <th style="min-width: 240px">Description</th>
                <th style="min-width: 150px">Headquarters</th>
                <th>Founded</th>
                <th style="min-width: 180px">Website</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            <% brands.forEach(brand => { %>
                <tr data-brand-id="<%= brand.brand_id %>">
                    <td class="col-id"><%= brand.brand_id %></td>
                    <td><input type="text" class="form-control brand-name fw-medium" value="<%= brand.brand_name %>"></td>
                    <td><textarea class="form-control brand-description" rows="1"><%= brand.brand_description %></textarea></td>
                    <td><input type="text" class="form-control brand-headquarters" value="<%= brand.headquarters %>"></td>
                    <td><input type="number" class="form-control brand-founded" style="min-width: 90px" value="<%= brand.founded_year %>"></td>
                    <td><input type="url" class="form-control brand-website" value="<%= brand.website %>"></td>
                    <td class="actions">
                        <a href="/products?brand_id=<%= brand.brand_id %>" target="_blank" class="btn btn-ghost btn-icon btn-sm" title="View products"><i class="bi bi-box-arrow-up-right"></i></a>
                        <button class="btn btn-brand btn-icon btn-sm" title="Save changes" onclick="updateBrand('<%= brand.brand_id %>', this)"><i class="bi bi-check-lg"></i></button>
                        <button class="btn btn-soft-danger btn-icon btn-sm" title="Delete" onclick="deleteBrand('<%= brand.brand_id %>')"><i class="bi bi-trash3"></i></button>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <div class="pager" data-table-pager="brandsTable"></div>
</main>

<%- include('../templates/footer'); %>
<script>
    async function updateBrand(brandId, btn) {
        const row = document.querySelector(`tr[data-brand-id='${brandId}']`);
        const get = sel => row.querySelector(sel).value;
        btn.disabled = true;
        try {
            const response = await fetch(`/brands/admin/${brandId}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    brand_id: brandId, name: get(".brand-name"), description: get(".brand-description"),
                    headquarters: get(".brand-headquarters"), founded_year: get(".brand-founded"), website: get(".brand-website")
                }),
            });
            const data = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(data.error || response.statusText);
            row.classList.remove("dirty");
            TVStore.notify("Brand saved");
        } catch (error) {
            TVStore.notify("Could not save the brand: " + error.message, "error");
        } finally {
            btn.disabled = false;
        }
    }

    async function deleteBrand(brandId) {
        const row = document.querySelector(`tr[data-brand-id='${brandId}']`);
        const ok = await TVStore.confirmDialog({
            title: `Delete ${row.querySelector(".brand-name").value}?`,
            message: "All products of this brand will be deleted too. This cannot be undone.",
            confirmText: "Delete brand"
        });
        if (!ok) return;
        try {
            const response = await fetch(`/brands/admin/${brandId}`, { method: "DELETE" });
            if (!response.ok) throw new Error();
            TVStore.notifyAfterReload("Brand and its products deleted");
            location.reload();
        } catch (error) {
            TVStore.notify("Could not delete the brand", "error");
        }
    }
</script>
</body>
</html>
