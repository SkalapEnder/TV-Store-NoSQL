<footer class="site-footer">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-5">
                <a class="brand-logo mb-2" href="/">
                    <span class="brand-mark"><i class="bi bi-tv"></i></span>
                    <span class="serif">TV Store</span>
                </a>
                <p class="mb-0 mt-2" style="max-width: 360px">Televisions from leading brands: OLED, QLED and LED screens for every room and budget.</p>
            </div>
            <div class="col-6 col-lg-2">
                <h6>Shop</h6>
                <ul>
                    <li><a href="/products">Catalog</a></li>
                    <li><a href="/brands">Brands</a></li>
                    <li><a href="/categories">Categories</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-2">
                <h6>Account</h6>
                <ul>
                    <% if (isLoggedIn) { %>
                        <li><a href="/auth/profile">Profile</a></li>
                        <li><a href="/auth/profile#orders">Orders</a></li>
                        <li><a href="/cart">Cart</a></li>
                    <% } else { %>
                        <li><a href="/auth/login">Log in</a></li>
                        <li><a href="/auth/register">Create account</a></li>
                    <% } %>
                </ul>
            </div>
            <div class="col-lg-3">
                <h6>Service</h6>
                <ul>
                    <li><i class="bi bi-truck me-2"></i>Free delivery</li>
                    <li><i class="bi bi-shield-check me-2"></i>Official warranty</li>
                    <li><i class="bi bi-arrow-repeat me-2"></i>14-day returns</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© <%= new Date().getFullYear() %> TV Store</span>
            <span>Alisher Berik · CSE-2604M</span>
        </div>
    </div>
</footer>

<div id="toast-stack" class="toast-stack" aria-live="polite"></div>
<% if (typeof flash !== 'undefined' && flash && flash.message) { %>
    <div id="flash-data" hidden data-type="<%= flash.type %>" data-message="<%= flash.message %>"></div>
<% } %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
