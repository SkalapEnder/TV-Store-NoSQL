<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('head', { title: 'Something went wrong' }); %>
</head>
<body>
<%- include('navbar'); %>

<main class="container page">
    <div class="surface surface-pad empty-state mx-auto fade-in" style="max-width: 560px">
        <i class="bi <%= typeof status !== 'undefined' && status === 404 ? 'bi-compass' : 'bi-exclamation-circle' %> empty-icon"></i>
        <h1 class="h3 mb-2"><%= typeof status !== 'undefined' && status === 404 ? 'Page not found' : 'Something went wrong' %></h1>
        <p class="mb-4"><%= errorMessage %></p>
        <div class="d-flex gap-2 justify-content-center">
            <button type="button" class="btn btn-outline-brand" onclick="history.back()"><i class="bi bi-arrow-left me-1"></i> Go back</button>
            <a href="/" class="btn btn-brand">Home page</a>
        </div>
    </div>
</main>

<%- include('footer'); %>
</body>
</html>
