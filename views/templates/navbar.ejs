<% const activePage = typeof active !== 'undefined' ? active : ''; %>
<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="brand-logo me-4" href="/">
                <span class="brand-mark"><i class="bi bi-tv"></i></span>
                <span class="serif">TV Store</span>
            </a>

            <div class="d-flex align-items-center gap-1 order-lg-3 ms-auto ms-lg-0">
                <button type="button" class="btn btn-ghost btn-icon theme-toggle" data-theme-toggle title="Toggle night mode" aria-label="Toggle night mode">
                    <i class="bi bi-moon-stars"></i><i class="bi bi-sun"></i>
                </button>

                <% if (isLoggedIn) { %>
                    <a href="/cart" class="btn btn-ghost btn-icon header-icon" title="Cart" aria-label="Cart">
                        <i class="bi bi-bag fs-5"></i>
                        <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
                            <span class="cart-badge"><%= cartCount > 99 ? '99+' : cartCount %></span>
                        <% } %>
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-ghost d-flex align-items-center gap-2 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar"><%= (username || '?').trim().charAt(0) %></span>
                            <span class="d-none d-xl-inline small fw-medium"><%= username %></span>
                            <i class="bi bi-chevron-down small text-muted d-none d-xl-inline"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">Signed in as <strong><%= username %></strong></h6></li>
                            <li><a class="dropdown-item" href="/auth/profile"><i class="bi bi-person"></i> My profile</a></li>
                            <li><a class="dropdown-item" href="/auth/profile#orders"><i class="bi bi-receipt"></i> My orders</a></li>
                            <li><a class="dropdown-item" href="/cart"><i class="bi bi-bag"></i> Cart</a></li>
                            <% if (userStatus === 'admin') { %>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Management</h6></li>
                                <li><a class="dropdown-item" href="/products/admin"><i class="bi bi-box-seam"></i> Products</a></li>
                                <li><a class="dropdown-item" href="/brands/admin"><i class="bi bi-award"></i> Brands</a></li>
                                <li><a class="dropdown-item" href="/categories/admin"><i class="bi bi-grid"></i> Categories</a></li>
                                <li><a class="dropdown-item" href="/users/admin"><i class="bi bi-people"></i> Users</a></li>
                            <% } %>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/auth/logout"><i class="bi bi-box-arrow-right"></i> Log out</a></li>
                        </ul>
                    </div>
                <% } else { %>
                    <a class="btn btn-ghost d-none d-sm-inline-flex" href="/auth/login">Log in</a>
                    <a class="btn btn-brand" href="/auth/register">Sign up</a>
                <% } %>

                <button class="navbar-toggler border-0 ms-1" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                    <i class="bi bi-list fs-4"></i>
                </button>
            </div>

            <div class="collapse navbar-collapse order-lg-2" id="mainNav">
                <ul class="navbar-nav me-lg-3 mt-3 mt-lg-0">
                    <li class="nav-item"><a class="nav-link <%= activePage === 'catalog' ? 'active' : '' %>" href="/products">Catalog</a></li>
                    <li class="nav-item"><a class="nav-link <%= activePage === 'brands' ? 'active' : '' %>" href="/brands">Brands</a></li>
                    <li class="nav-item"><a class="nav-link <%= activePage === 'categories' ? 'active' : '' %>" href="/categories">Categories</a></li>
                    <li class="nav-item"><a class="nav-link <%= activePage === 'foryou' ? 'active' : '' %>" href="/recommendations"><i class="bi bi-stars me-1"></i>For you</a></li>
                </ul>
                <form class="header-search position-relative my-3 my-lg-0 me-lg-auto" action="/products" method="GET" role="search">
                    <i class="bi bi-search"></i>
                    <input class="form-control" type="search" name="q" placeholder="Search TVs, brands, models…" aria-label="Search" maxlength="100"
                           value="<%= typeof query !== 'undefined' && query && query.q ? query.q : '' %>">
                </form>
            </div>
        </div>
    </nav>
</header>
