<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../templates/head', { title: 'Log in' }); %>
</head>
<body>
<%- include('../templates/navbar'); %>

<main class="container">
    <div class="auth-wrap fade-in">
        <div class="surface auth-card">
            <div class="text-center mb-4">
                <span class="brand-mark mb-3" style="width: 48px; height: 48px; font-size: 1.3rem"><i class="bi bi-cpu"></i></span>
                <h1 class="serif mb-1">Welcome back</h1>
                <p class="text-muted mb-0">Log in to your <%= storeName %> account</p>
            </div>

            <form id="loginForm" novalidate>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" autocomplete="email" required>
                </div>
                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="password" name="password" placeholder="Your password" autocomplete="current-password" required>
                        <button type="button" class="btn btn-outline-brand" id="togglePassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
                    </div>
                </div>

                <div class="alert alert-danger d-none" id="error" role="alert"></div>

                <button type="submit" id="submit" class="btn btn-brand btn-lg w-100">Log in</button>
            </form>

            <div class="divider-text">New here?</div>
            <a href="/auth/register" class="btn btn-outline-brand w-100">Create an account</a>
        </div>
    </div>
</main>

<%- include('../templates/footer'); %>
<script>
    const form = document.getElementById('loginForm');
    const submit = document.getElementById('submit');
    const error = document.getElementById('error');

    document.getElementById('togglePassword').addEventListener('click', function () {
        const input = document.getElementById('password');
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        this.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
    });

    form.addEventListener('submit', async function (e) {
        e.preventDefault();
        error.classList.add('d-none');
        submit.disabled = true;
        submit.textContent = 'Logging in…';
        try {
            const response = await fetch('/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    email: document.getElementById('email').value,
                    password: document.getElementById('password').value
                })
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.errorMessage || 'An unknown error occurred');

            TVStore.notifyAfterReload('You are logged in. Welcome back!');
            window.location.href = data.redirectUrl || '/';
        } catch (err) {
            error.textContent = err.message;
            error.classList.remove('d-none');
            submit.disabled = false;
            submit.textContent = 'Log in';
        }
    });
</script>
</body>
</html>
