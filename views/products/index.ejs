<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../templates/head', { title: 'Catalog' }); %>
</head>
<body>
<% const q = (typeof query !== 'undefined' && query) || {}; %>
<%- include('../templates/navbar', { active: 'catalog', query: q }); %>

<main class="container page">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Televisions</li>
        </ol>
    </nav>
    <div class="page-header">
        <div>
            <h1 class="serif">Televisions</h1>
            <p class="lead-text"><% if (q.q) { %>Results for “<%= q.q %>”<% } else { %>OLED, QLED and LED models from leading brands<% } %></p>
        </div>
        <button class="btn btn-outline-brand d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse" aria-expanded="false">
            <i class="bi bi-sliders me-1"></i> Filters
        </button>
    </div>

    <div class="row g-4">
        <!-- Filters -->
        <aside class="col-lg-3">
            <div class="collapse d-lg-block" id="filtersCollapse">
                <form id="filterForm" class="surface surface-pad filters-panel" action="/products" method="GET">
                    <div class="filter-group">
                        <div class="filter-title">Search</div>
                        <div class="position-relative">
                            <input type="search" id="product_search" name="q" class="form-control" placeholder="Name, model…" maxlength="100" value="<%= q.q || '' %>">
                        </div>
                    </div>

                    <div class="filter-group">
                        <div class="filter-title">Type</div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="category_id" id="cat_all" value="" <%= !q.category_id ? 'checked' : '' %>>
                            <label class="form-check-label" for="cat_all">All types</label>
                        </div>
                        <% categories.forEach(c => { %>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="category_id" id="cat_<%= c.category_id %>" value="<%= c.category_id %>"
                                       <%= String(q.category_id) === String(c.category_id) ? 'checked' : '' %>>
                                <label class="form-check-label" for="cat_<%= c.category_id %>"><%= c.category_name %></label>
                            </div>
                        <% }) %>
                    </div>

                    <div class="filter-group">
                        <label class="filter-title d-block" for="brand_filter">Brand</label>
                        <select class="form-select" id="brand_filter" name="brand_id">
                            <option value="">All brands</option>
                            <% brands.forEach(b => { %>
                                <option value="<%= b.brand_id %>" <%= String(q.brand_id) === String(b.brand_id) ? 'selected' : '' %>><%= b.brand_name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="filter-group">
                        <div class="filter-title">Price, ₸</div>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="number" name="min" min="0" step="1000" class="form-control" placeholder="from" value="<%= q.min || '' %>" aria-label="Minimum price">
                            <span class="text-muted">–</span>
                            <input type="number" name="max" min="0" step="1000" class="form-control" placeholder="to" value="<%= q.max || '' %>" aria-label="Maximum price">
                        </div>
                    </div>

                    <div class="filter-group">
                        <div class="filter-title">Screen size, inches</div>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="number" name="min_diag" min="0" max="120" class="form-control" placeholder="from" value="<%= q.min_diag || '' %>" aria-label="Minimum diagonal">
                            <span class="text-muted">–</span>
                            <input type="number" name="max_diag" min="0" max="120" class="form-control" placeholder="to" value="<%= q.max_diag || '' %>" aria-label="Maximum diagonal">
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <% [[0, 43, 'up to 43″'], [50, 55, '50–55″'], [65, 65, '65″'], [75, 120, '75″+']].forEach(([from, to, label]) => { %>
                                <button type="button" class="btn btn-outline-brand btn-sm" data-diag="<%= from %>,<%= to %>"><%= label %></button>
                            <% }) %>
                        </div>
                    </div>

                    <div class="filter-group">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="in_stock" name="in_stock" value="true" <%= q.in_stock === 'true' ? 'checked' : '' %>>
                            <label class="form-check-label" for="in_stock">In stock only</label>
                        </div>
                    </div>

                    <div class="d-grid gap-2 pt-3">
                        <button type="submit" class="btn btn-brand" data-no-lock>Show results</button>
                        <a href="/products" class="btn btn-ghost btn-sm">Reset all filters</a>
                    </div>
                </form>
            </div>
        </aside>

        <!-- Results -->
        <section class="col-lg-9">
            <div class="catalog-toolbar">
                <span class="result-count" id="result_count"><%= products.length %> <%= products.length === 1 ? 'product' : 'products' %></span>
                <div class="d-flex align-items-center gap-2">
                    <label for="sort" class="text-muted small text-nowrap">Sort by</label>
                    <select class="form-select form-select-sm" id="sort" name="sort" form="filterForm" style="min-width: 190px">
                        <option value="">Relevance</option>
                        <option value="price_asc" <%= q.sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
                        <option value="price_desc" <%= q.sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
                        <option value="diagonal" <%= q.sort === 'diagonal' ? 'selected' : '' %>>Largest screen</option>
                        <option value="rating" <%= q.sort === 'rating' ? 'selected' : '' %>>Most reviewed</option>
                        <option value="name" <%= q.sort === 'name' ? 'selected' : '' %>>Name</option>
                    </select>
                </div>
            </div>

            <div id="product_list">
                <%- include('_grid', { products, back: typeof back !== 'undefined' ? back : '/products' }); %>
            </div>
        </section>
    </div>
</main>

<%- include('../templates/footer'); %>
<script>
    const filterForm = document.getElementById('filterForm');
    const list = document.getElementById('product_list');
    const count = document.getElementById('result_count');
    let controller = null;

    function currentParams() {
        const params = {};
        new FormData(filterForm).forEach((value, key) => {
            if (String(value).trim() !== '') params[key] = value;
        });
        return params;
    }

    async function applyFilters() {
        const params = currentParams();
        if (controller) controller.abort();
        controller = new AbortController();
        list.classList.add('loading');
        try {
            // The server renders the cards (same template as the first page load)
            const response = await fetch('/products/filter?view=grid', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'text/html' },
                body: JSON.stringify(params),
                signal: controller.signal
            });
            if (!response.ok) throw new Error('Search failed');
            list.innerHTML = await response.text();
            const n = list.querySelectorAll('.product-card').length;
            count.textContent = `${n} ${n === 1 ? 'product' : 'products'}`;
            history.replaceState(null, '', '/products' + (Object.keys(params).length ? '?' + new URLSearchParams(params) : ''));
        } catch (err) {
            if (err.name !== 'AbortError') TVStore.notify('Could not load products. Please try again.', 'error');
        } finally {
            list.classList.remove('loading');
        }
    }

    filterForm.addEventListener('submit', e => { e.preventDefault(); applyFilters(); });
    // Apply right away when a choice changes; typing waits for a short pause
    filterForm.addEventListener('change', e => { if (e.target.type !== 'search' && e.target.type !== 'number') applyFilters(); });
    document.getElementById('sort').addEventListener('change', applyFilters);
    let typingTimer;
    filterForm.addEventListener('input', e => {
        if (e.target.type !== 'search' && e.target.type !== 'number') return;
        clearTimeout(typingTimer);
        typingTimer = setTimeout(applyFilters, 450);
    });

    document.querySelectorAll('[data-diag]').forEach(btn => btn.addEventListener('click', () => {
        const [from, to] = btn.dataset.diag.split(',');
        filterForm.min_diag.value = from === '0' ? '' : from;
        filterForm.max_diag.value = to;
        applyFilters();
    }));
</script>
</body>
</html>
