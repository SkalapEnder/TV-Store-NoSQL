<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../templates/head', { title: 'Brands' }); %>
</head>
<body>
<%- include('../templates/navbar', { active: 'brands' }); %>

<main class="container page">
    <div class="page-header">
        <div>
            <h1 class="serif">Brands</h1>
            <p class="lead-text"><%= brands.length %> manufacturers in our catalog</p>
        </div>
    </div>

    <% if (!brands.length) { %>
        <div class="surface empty-state"><i class="bi bi-award empty-icon"></i><p class="mb-0">No brands yet.</p></div>
    <% } else { %>
        <div class="row g-3">
            <% brands.slice().sort((a, b) => String(a.brand_name).localeCompare(String(b.brand_name))).forEach(brand => { %>
                <div class="col-sm-6 col-lg-4 col-xl-3 fade-in">
                    <div class="surface surface-pad h-100 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="avatar" style="width: 46px; height: 46px; border-radius: 12px"><%= String(brand.brand_name || '?').charAt(0) %></span>
                            <div class="min-w-0">
                                <h2 class="h5 mb-0 text-truncate"><%= brand.brand_name %></h2>
                                <div class="small text-muted">
                                    <%= [brand.headquarters, brand.founded_year ? 'since ' + brand.founded_year : null].filter(Boolean).join(' · ') || 'Manufacturer' %>
                                </div>
                            </div>
                        </div>
                        <% if (brand.brand_description) { %>
                            <p class="small text-muted mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"><%= brand.brand_description %></p>
                        <% } %>
                        <div class="mt-auto d-flex gap-2">
                            <a href="/products?brand_id=<%= brand.brand_id %>" class="btn btn-brand btn-sm flex-grow-1">View TVs</a>
                            <% if (brand.website) { %>
                                <a href="<%= brand.website %>" target="_blank" rel="noopener" class="btn btn-outline-brand btn-sm" title="Official website"><i class="bi bi-box-arrow-up-right"></i></a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('../templates/footer'); %>
</body>
</html>
