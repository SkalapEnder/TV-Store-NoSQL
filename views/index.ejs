<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('templates/head', { title: 'Televisions' }); %>
</head>
<body>
<%- include('templates/navbar', { active: 'home' }); %>

<main class="container page">
    <!-- Hero -->
    <section class="hero mb-5 fade-in">
        <span class="small-caps" style="color: rgba(255,255,255,.65)">TV Store · Collection <%= new Date().getFullYear() %></span>
        <h1 class="serif mt-3 mb-3">Cinema-grade picture, right in your living room</h1>
        <p class="mb-4">OLED, QLED and LED televisions from the world's leading brands. Compare by size, type and price, and choose the one that fits your room.</p>
        <div class="d-flex flex-wrap gap-2">
            <a href="/products" class="btn btn-light btn-lg">Browse catalog <i class="bi bi-arrow-right ms-1"></i></a>
            <% if (!isLoggedIn) { %>
                <a href="/auth/register" class="btn btn-outline-light btn-lg">Create account</a>
            <% } %>
        </div>
        <div class="hero-perks">
            <span><i class="bi bi-truck"></i>Free delivery</span>
            <span><i class="bi bi-shield-check"></i>Official warranty</span>
            <span><i class="bi bi-arrow-repeat"></i>14-day returns</span>
        </div>
    </section>

    <!-- Categories -->
    <% if (categories && categories.length) { %>
        <section class="mb-5">
            <div class="section-title">
                <h2>Shop by type</h2>
                <a href="/categories" class="small fw-medium">All categories <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="row g-3">
                <% categories.forEach(c => { %>
                    <div class="col-6 col-md-4 col-lg">
                        <a class="category-chip" href="/products?category_id=<%= c.category_id %>">
                            <span class="chip-icon"><i class="bi bi-tv"></i></span>
                            <span>
                                <span class="chip-name d-block"><%= c.category_name %></span>
                                <span class="chip-sub"><%= c.count %> <%= c.count === 1 ? 'model' : 'models' %></span>
                            </span>
                        </a>
                    </div>
                <% }) %>
            </div>
        </section>
    <% } %>

    <!-- Personal recommendations (collaborative filtering) -->
    <% if (typeof recommended !== 'undefined' && recommended && recommended.items && recommended.items.length) { %>
        <section class="mb-5">
            <div class="section-title">
                <div>
                    <h2 class="mb-1"><i class="bi bi-stars me-2" style="color: var(--gold)"></i>Recommended for you</h2>
                    <p class="text-muted small mb-0"><%= recommended.personalized > 0 ? 'Based on your views, ratings and purchases' : 'Popular picks while we learn your taste' %></p>
                </div>
                <a href="/recommendations" class="small fw-medium">See all <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="row g-3 g-xl-4">
                <% recommended.items.forEach(product => { %>
                    <div class="col-6 col-md-4 col-lg-3"><%- include('products/_card', { product, back: '/' }); %></div>
                <% }) %>
            </div>
        </section>
    <% } %>

    <!-- Recently viewed -->
    <% if (isLoggedIn && recentHistory && recentHistory.length > 0) { %>
        <section class="mb-5">
            <div class="section-title">
                <h2>Recently viewed</h2>
                <a href="/auth/profile#viewed" class="small fw-medium">Full history <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="row g-3">
                <% recentHistory.forEach(item => { %>
                    <div class="col-sm-6 col-lg-3">
                        <a class="history-card" href="/products/<%= item.product_id %>">
                            <% if (item.pictures && item.pictures.length) { %>
                                <img class="thumb" src="<%= item.pictures[0] %>" alt="" loading="lazy">
                            <% } %>
                            <div class="min-w-0">
                                <div class="hc-name"><%= item.name || 'Product' %></div>
                                <div class="price mt-1"><%= typeof item.price === 'number' ? item.price.toLocaleString('ru-RU') : '—' %><small>₸</small></div>
                            </div>
                        </a>
                    </div>
                <% }) %>
            </div>
        </section>
    <% } %>

    <!-- Featured -->
    <section>
        <div class="section-title">
            <h2>Popular right now</h2>
            <a href="/products" class="small fw-medium">View all <i class="bi bi-arrow-right"></i></a>
        </div>
        <% if (featured && featured.length) { %>
            <div class="row g-3 g-xl-4">
                <% featured.forEach(product => { %>
                    <div class="col-6 col-md-4 col-lg-3">
                        <%- include('products/_card', { product, back: '/' }); %>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="surface empty-state">
                <i class="bi bi-box-seam empty-icon"></i>
                <p class="mb-0">The catalog is empty for now.</p>
            </div>
        <% } %>
    </section>
</main>

<%- include('templates/footer'); %>
</body>
</html>
