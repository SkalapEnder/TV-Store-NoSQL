<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../templates/head', { title: 'Categories' }); %>
</head>
<body>
<%- include('../templates/navbar', { active: 'categories' }); %>

<main class="container page">
    <div class="page-header">
        <div>
            <h1 class="serif">Display types</h1>
            <p class="lead-text">Choose the screen technology that suits you</p>
        </div>
    </div>

    <% if (!categories.length) { %>
        <div class="surface empty-state"><i class="bi bi-grid empty-icon"></i><p class="mb-0">No categories yet.</p></div>
    <% } else { %>
        <div class="row g-3">
            <% categories.forEach(category => { %>
                <div class="col-md-6 col-xl-4 fade-in">
                    <a href="/products?category_id=<%= category.category_id %>" class="category-chip align-items-start p-4">
                        <span class="chip-icon"><i class="bi bi-tv"></i></span>
                        <span class="flex-grow-1">
                            <span class="chip-name d-block fs-5"><%= category.category_name %></span>
                            <span class="chip-sub d-block mt-1"><%= category.category_description || 'Browse all ' + category.category_name + ' televisions' %></span>
                        </span>
                        <i class="bi bi-arrow-right text-muted"></i>
                    </a>
                </div>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('../templates/footer'); %>
</body>
</html>
